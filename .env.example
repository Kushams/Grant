# National Empowerment Network (NEN) — local environment template.
# Copy to .env (`cp .env.example .env`). NEVER commit a real .env file or real secrets.

# SQLite database file for the local prototype (relative to the project root).
# Moving to production: switch the Prisma datasource provider to postgresql, set a
# managed database URL here and replace the better-sqlite3 adapter in src/lib/db.ts.
DATABASE_URL="file:./dev.db"

# Local-only password applied to every SEEDED demo account (`npm run db:seed`).
# Pick any value; it is hashed with bcrypt before storage. Do not reuse it anywhere else.
# If omitted, the seed script falls back to the documented placeholder in README.md.
DEMO_SEED_PASSWORD="Demo-Passw0rd!"

# Shows the one-click "demo sign-in" helper on /login. Ignored when NODE_ENV=production.
ENABLE_DEMO_LOGIN="true"

# Set to "true" only behind HTTPS to force Secure cookies when running `next start`
# locally over plain HTTP this must stay unset/false. (Cookies are Secure automatically
# when NODE_ENV=production AND this is not "false".)
# SESSION_COOKIE_SECURE="false"

# NOTE: NEN intentionally has NO payment-provider, email or SMS credentials. The
# prototype never moves money and never sends external messages.
